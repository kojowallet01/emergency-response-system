# Example environment variables for local development
# Copy this file to .env and replace values before running the backend

# MongoDB connection string. You can use MongoDB Atlas or a local MongoDB instance.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ebrs?retryWrites=true&w=majority

# (Optional) Google Maps API key for geocoding
GOOGLE_API_KEY=your_google_api_key_here

# Backend port
PORT=4000
